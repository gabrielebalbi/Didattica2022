scan_dr_hw_jtag 32 -tdi 8001000C ; # scrivi 1 parola a cmd
scan_dr_hw_jtag 32 -tdi F0000000 ; # scrivi  codice comando
scan_dr_hw_jtag 32 -tdi 00000004 ; # nop




