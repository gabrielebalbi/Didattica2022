<?xml version="1.0" encoding="UTF-8"?>
<sdx:platform sdx:vendor="xilinx.com"
              sdx:library="sdx"
              sdx:name="MCDMA_ila_bsp"
              sdx:version="1.0"
              sdx:schemaVersion="1.0"
              xmlns:sdx="http://www.xilinx.com/sdx">
    <sdx:description>
MCDMA_ila_bsp
    </sdx:description>
    <sdx:systemConfigurations sdx:defaultConfiguration="MCDMA_ila_bsp">
        <sdx:configuration sdx:name="MCDMA_ila_bsp"
                           sdx:displayName="MCDMA_ila_bsp"
                           sdx:defaultProcessorGroup="standalone_domain"
                           sdx:runtimes="cpp">
            <sdx:description>MCDMA_ila_bsp</sdx:description>
            <sdx:bootImages sdx:default="standard">
                <sdx:image sdx:name="standard"
                            sdx:bif="MCDMA_ila_bsp/boot/MCDMA_ila_bsp.bif"
                            sdx:readme="MCDMA_ila_bsp/boot/generic.readme"
                            />
            </sdx:bootImages>
            <sdx:processorGroup sdx:name="standalone_domain"
                                sdx:displayName="standalone on microblaze_0"
                                sdx:cpuType="microblaze_0"
                                sdx:cpuInstance="microblaze_0">
                <sdx:os sdx:name="standalone"
                        sdx:displayName="standalone"
                        sdx:bspLibraryPaths="MCDMA_ila_bsp/standalone_domain/bsplib/lib"
                        sdx:bspIncludePaths="MCDMA_ila_bsp/standalone_domain/bspinclude/include"
                        sdx:bspConfig="MCDMA_ila_bsp/standalone_domain/system.mss"
                />
            </sdx:processorGroup>
        </sdx:configuration>
    </sdx:systemConfigurations>
</sdx:platform>
