<?xml version="1.0" encoding="UTF-8"?>
<sdx:platform sdx:vendor="xilinx.com"
              sdx:library="sdx"
              sdx:name="iic_spi_10KHz_ILA"
              sdx:version="1.0"
              sdx:schemaVersion="1.0"
              xmlns:sdx="http://www.xilinx.com/sdx">
    <sdx:description>
iic_spi_10KHz_ILA
    </sdx:description>
    <sdx:systemConfigurations sdx:defaultConfiguration="iic_spi_10KHz_ILA">
        <sdx:configuration sdx:name="iic_spi_10KHz_ILA"
                           sdx:displayName="iic_spi_10KHz_ILA"
                           sdx:defaultProcessorGroup="standalone_domain"
                           sdx:runtimes="cpp">
            <sdx:description>iic_spi_10KHz_ILA</sdx:description>
            <sdx:bootImages sdx:default="standard">
                <sdx:image sdx:name="standard"
                            sdx:bif="iic_spi_10KHz_ILA/boot/iic_spi_10KHz_ILA.bif"
                            sdx:readme="iic_spi_10KHz_ILA/boot/generic.readme"
                            />
            </sdx:bootImages>
            <sdx:processorGroup sdx:name="standalone_domain"
                                sdx:displayName="standalone on microblaze_0"
                                sdx:cpuType="microblaze_0"
                                sdx:cpuInstance="microblaze_0">
                <sdx:os sdx:name="standalone"
                        sdx:displayName="standalone"
                        sdx:bspLibraryPaths="iic_spi_10KHz_ILA/standalone_domain/bsplib/lib"
                        sdx:bspIncludePaths="iic_spi_10KHz_ILA/standalone_domain/bspinclude/include"
                        sdx:bspConfig="iic_spi_10KHz_ILA/standalone_domain/system.mss"
                />
            </sdx:processorGroup>
        </sdx:configuration>
    </sdx:systemConfigurations>
</sdx:platform>
